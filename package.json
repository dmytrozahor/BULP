{
  "name": "ukr-lexicon",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "mine": "tsx pipelines/ingest.ts",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "build:data": "tsx pipelines/fetch-hist-lex.ts && tsx pipelines/parse-hist-lex.ts && tsx pipelines/fetch-hist-typed.ts && tsx pipelines/parse-hist-typed.ts && tsx pipelines/fetch-hist-ws.ts && tsx pipelines/parse-hist-ws.ts && tsx pipelines/build.ts && tsx pipelines/build-thin-par.ts && tsx pipelines/build-stress-src.ts && tsx pipelines/build-parts.ts && tsx pipelines/build-labels.ts && tsx pipelines/build-persons.ts && tsx pipelines/build-presence.ts",
    "cache:report": "tsx pipelines/stage-cache.ts report",
    "cache:gc": "tsx pipelines/stage-cache.ts gc",
    "cache:clear": "tsx pipelines/stage-cache.ts clear",
    "data:publish": "tsx pipelines/data-cdn.ts upload",
    "data:prune": "tsx pipelines/data-cdn.ts prune",
    "data:branch:publish": "tsx pipelines/data-branch.ts publish",
    "data:texts": "tsx pipelines/emit-texts.ts",
    "data:unlinked": "tsx pipelines/build-unlinked.ts && tsx pipelines/build-presence.ts",
    "data:etymology": "tsx pipelines/etymology.ts",
    "data:cognates": "tsx pipelines/cognates.ts",
    "audit:senses": "tsx pipelines/sense-audit.ts",
    "report:se": "tsx pipelines/se-report.ts",
    "parse:se": "tsx pipelines/parse-se-dicts.ts",
    "budget": "tsx pipelines/budget.ts",
    "data:parts": "tsx pipelines/build-parts.ts",
    "data:presence": "tsx pipelines/build-presence.ts",
    "data:labels": "tsx pipelines/build-labels.ts",
    "data:persons": "tsx pipelines/build-persons.ts",
    "data:portraits": "tsx pipelines/persons-portraits.ts",
    "data:pull": "tsx pipelines/data-cdn.ts pull",
    "data:branch:pull": "tsx pipelines/data-branch.ts pull",
    "harvest:ingest": "tsx pipelines/ingest-harvest.ts",
    "ingest:rib": "tsx pipelines/ingest-rib.ts",
    "ingest:kvitka": "tsx pipelines/ingest-kvitka.ts",
    "ingest:pum": "tsx pipelines/ingest-pum.ts",
    "harvest:launch": "powershell -NoProfile -File harvest/launch.ps1",
    "harvest:status": "powershell -NoProfile -File harvest/status.ps1",
    "data:hist-lex": "tsx pipelines/fetch-hist-lex.ts && tsx pipelines/parse-hist-lex.ts && tsx pipelines/fetch-hist-typed.ts && tsx pipelines/parse-hist-typed.ts && tsx pipelines/fetch-hist-ws.ts && tsx pipelines/parse-hist-ws.ts",
    "e2e:cards": "tsx pipelines/e2e-cards.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^6.4.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
