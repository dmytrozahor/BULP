bornyk.org.ua/shevelov/shev04.htm, розд. 14","quote":"Іп. літоп. — зроблена бл. 1425 р. російська копія давньоукраїнського ориґіналу …, що містить Найдавніший (Початковий) Київський літопис, Київський літопис (1117-1200) і пізніші Галицький та Волинський літописи (1200 -1292)","kind":"Q"},{"source":"ukrainian-word-stress","locator":"ULIF-derived","quote":"всіва́ти","kind":"D","note":"ukrainian-word-stress 2.1.0 (data derived from ULIF «Словники України»; licence unclear); словниковий запис без контексту; статус невідомий (research/08 A3)"},{"source":"VESUM","locator":"dict_corp_vis.txt v6.8.6","quote":"всівати verb:imperf:inf (лема: всівати)","kind":"D"},{"source":"stanza orv","locator":"stanza 1.15.0 orv/torot (lemma torot_nocharlm, pos torot_nopretrain; TOROT treebank)","quote":"вьсѣваеть → «въсѣвати»","kind":"D","note":"модельна лематизація, не словниковий факт (P-1.7)"},{"source":"arch","locator":"Мт 28:4","quote":"же сѧ стрегѹщеи и быша ꙗко [мьртви]","kind":"D"},{"source":"ukrainian-word-stress","locator":"ULIF-derived","quote":"ме́ртва","kind":"D","note":"ukrainian-word-stress 2.1.0 (data derived from ULIF «Словники України»; licence unclear); словниковий запис без контексту; статус невідомий (research/08 A3)"},{"source":"ukrainian-word-stress","locator":"ULIF-derived","quote":"мертви́","kind":"D","note":"ukrainian-word-stress 2.1.0 (data derived from ULIF «Словники України»; licence unclear); словниковий запис без контексту; статус невідомий (research/08 A3)"},{"source":"VESUM","locator":"dict_corp_vis.txt v6.8.6","quote":"мертва noun:anim:f:v_naz (лема: мертва)","kind":"D"},{"source":"stanza orv","locator":"stanza 1.15.0 orv/torot (lemma torot_nocharlm, pos torot_nopretrain; TOROT treebank)","quote":"мьртви → «мьртва»","kind":"D","note":"модельна лематизація, не словниковий факт (P-1.7)"}],"lemmas":["бахчисарайський","галушка","врізати","посох","всівати","мертва"],"details":[{"first":{"value":{"loc":"абз. 38","witnessType":"scholarly_ed","coFirst":[]},"evide